# Copia in config.env (ignorato da git) e compila
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://localhost
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
CTRADER_ENV=demo   # demo | live
CTRADER_SYMBOL=XAUUSD   # nome dello strumento sul broker (se diverso)

# MetaTrader 5 (solo Windows, solo lettura prezzi)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_SYMBOL=         # nome dell'oro sul broker; anche più nomi separati da virgola (es. GOLD, XAUUSD). Vuoto = lo cerca da solo su ogni conto
MT5_UTC_OFFSET_HOURS=   # ora del server del broker meno UTC (es. 2 o 3); vuoto = automatico a mercato aperto

# Telegram: lettura canale con il tuo account (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CANALE=   # titolo del canale da cui leggere i segnali (opzionale)
SENZA_BOT=   # 1 = nessuna notifica sul bot Telegram: legge solo il canale e apre; si vede tutto in Gestione Conti
AVVIO_ASCOLTO=   # 0 = Gestione Conti non avvia da solo l'ascolto dei segnali (default: lo avvia)

# Segnali di Cedric (ascolto del canale, apertura sui conti, scheda Automatico): attivi di default.
SEGNALI=                  # vuoto = segnali di Cedric attivi (ascolto + pagina Automatico); 0 = spenti

# MT5 dedicato a ogni conto (portable): copia dell'MT5 installato. MT5_SOURCE = cartella da copiare, MT5_BASE = dove creare le copie (una cartella per conto).
MT5_SOURCE=
MT5_BASE=

# Se il prezzo si è spostato oltre questi $ dall'Entry atteso sul tuo broker, i segnali non aprono a mercato ma mettono un ordine pendente (LIMIT o STOP) sull'Entry. Vuoto = 1.5
ENTRY_DEV_MAX=

# Più canali di segnali: nomi o id separati da virgola (il primo è quello storico). Ogni canale ha il suo scarto di prezzo (scarti_<canale>.csv).
# TELEGRAM_CANALE=Cedric FX - Élite, AuraKage
# Pips minimi mancanti al TP1 per aprire a mercato, per canale (se manca vale MIN_REMAINING_PIPS=45): MIN_PIPS_<CANALE>, es. MIN_PIPS_AURAKAGE=0
