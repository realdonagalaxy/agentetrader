# Copia in config.env (ignorato da git) e compila
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_REDIRECT_URI=http://localhost
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_ID=
CTRADER_ENV=demo   # demo | live
CTRADER_SYMBOL=XAUUSD   # nome dello strumento sul broker (se diverso)

# MetaTrader 5 (solo Windows, solo lettura prezzi)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_SYMBOL=XAUUSD   # nome dello strumento sul broker (es. GOLD, XAUUSD.m)
MT5_UTC_OFFSET_HOURS=   # ora del server del broker meno UTC (es. 2 o 3); vuoto = automatico a mercato aperto

# Telegram: lettura canale con il tuo account (my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CANALE=   # titolo del canale da cui leggere i segnali (opzionale)
SENZA_BOT=   # 1 = nessuna notifica sul bot Telegram: legge solo il canale e apre; si vede tutto in Gestione Conti
AVVIO_ASCOLTO=   # 0 = Gestione Conti non avvia da solo l'ascolto dei segnali (default: lo avvia)
